<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>LumenWorksCsvReader2</id>
    <version>4.5.0</version>
    <title>LumenWorks CSV Reader 2</title>
    <authors>Sébastien Lorion, Paul Hatcher, Maxim Ivanov</authors>
    <owners>Maxim Ivanov</owners>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://github.com/drcolombo/CsvReader</projectUrl>
    <repository type="github" url="https://github.com/drcolombo/CsvReader" />
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>An extended version of LumenWorksCsvReader</description>
    <releaseNotes>
		Removed support of .NET 6.0 and .NET 7.0. Added support of .NET 9.0 and 10.0. Exception thrown with duplicated colum names
	</releaseNotes>
    <copyright>Copyright © 2005 Sébastien Lorion, 2014 Paul Hatcher, 2020-2022 Maxim Ivanov</copyright>
    <tags>CSV cvs-reader</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.8" />
      <group targetFramework=".NET8.0" />
      <group targetFramework=".NET9.0" />
      <group targetFramework=".NET10.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="NETStandard.Library" version="2.0.3"/>
	  </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\build\CsvReader\Release\net48\CsvReader.*" target="lib\net48" />
    <file src="..\build\CsvReader\Release\net8.0\CsvReader.*" target="lib\net8.0" />
    <file src="..\build\CsvReader\Release\net9.0\CsvReader.*" target="lib\net9.0" />
    <file src="..\build\CsvReader\Release\net10.0\CsvReader.*" target="lib\net10.0" />
    <file src="..\build\CsvReader\Release\netstandard2.0\CsvReader.*" target="lib\netstandard2.0" />
	
	<file src="..\readme.md" target="docs" />
  </files>
</package>